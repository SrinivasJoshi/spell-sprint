# ====================================================================
# .env.preview template
# ====================================================================
ENVIRONMENT=preview

# Public base URL of the preview environment (used by Better Auth)
APP_BASE_URL=https://preview.example.com

# Better Auth signing/encryption secret. REQUIRED for preview/production.
# Use a different value per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Shared secret for the management CLI (`npm run auth ...`). Must match the
# CLI_API_KEY deployed to the preview worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLI_API_KEY=

# CLI API URL override (optional)
CLI_API_URL_PREVIEW=https://preview.example.com

# Google sign-in. Written (and verified) by `npm run setup:google`, which also
# turns config.auth.enableGoogleAuth on. See docs/GOOGLE_AUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Blankrace: HMAC secret that signs Guest tokens (src/worker/lib/guest-token.ts).
# REQUIRED for preview/production; local falls back to a dev secret. Changing it
# turns every Guest into a new one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_TOKEN_SECRET=
